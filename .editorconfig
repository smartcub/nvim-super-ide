# Editor settings for this repository (https://editorconfig.org). Neovim,
# VS Code, JetBrains IDEs and GitHub's web view follow them, so every
# contributor's editor indents and saves these files the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
